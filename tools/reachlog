#!/bin/bash
# Live view of the reaching executor's log lines. Follows the newest
# diagnostic log AND switches to a newer one when the app restarts,
# so one running copy survives restarts (operator, 2026-08-27:
# "reachlog not showing anything" after a restart).
current=""
tailpid=""
trap '[ -n "$tailpid" ] && kill "$tailpid" 2>/dev/null' EXIT
while true; do
    newest=$(ls -t ~/.config/js8call-diag-*.log 2>/dev/null | head -1)
    if [ -n "$newest" ] && [ "$newest" != "$current" ]; then
        [ -n "$tailpid" ] && kill "$tailpid" 2>/dev/null
        current="$newest"
        echo "=== following $(basename "$current") ==="
        tail -F -n +1 "$current" 2>/dev/null \
            | grep --line-buffered '\[REACH\]' \
            | sed -u 's/^.*\[REACH\] //' &
        tailpid=$!
    fi
    sleep 2
done
